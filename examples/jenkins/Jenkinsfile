// OpenCTEM CI scanning on Jenkins: one parallel stage per capability, then
// one gate, reporting to OpenCTEM with a token from the OpenID Connect
// Provider plugin. No stored secret.
//
// Setup (docs/other-ci.md): install the OpenID Connect Provider plugin, add
// its claim templates repository=${GIT_URL}, branch=${BRANCH_NAME} (or
// ${GIT_BRANCH}) and sha=${GIT_COMMIT}, and an "OpenID Connect id token"
// credential "openctem-oidc" whose audience is
// openctem:tenant:<your organization id>; then add a Jenkins CI trust in
// OpenCTEM for the credential's issuer. Set OPENCTEM_API_URL and
// OPENCTEM_TENANT_ID below; with OPENCTEM_TENANT_ID empty the stages scan
// only (SARIF, GitLab-format reports and the local gate).
//
// Needs an agent with Docker. Images are pinned by digest
// (scripts/pin-images.sh rewrites them on a release).

def ciImage = 'ghcr.io/openctemio/ci:edge@sha256:2887311f4510e20e0cac51be11802bcbb97bdc66dc16274974ef88871e5016ad'

def openctem(String image, String args) {
    // The job's token is bound for this call only (a fresh one each time)
    // and passed to the container by name, never on the command line.
    if (env.OPENCTEM_TENANT_ID?.trim()) {
        withCredentials([string(credentialsId: 'openctem-oidc', variable: 'OPENCTEM_ID_TOKEN')]) {
            dockerRun(image, args)
        }
    } else {
        dockerRun(image, args)
    }
}

def dockerRun(String image, String args) {
    // Read-only root, no capabilities, the agent's user; the checkout is
    // mounted at /src and reports go to openctem-out/.
    sh """
      mkdir -p openctem-out
      docker run --rm --read-only --tmpfs /tmp --tmpfs /home/openctem:uid=\$(id -u),gid=\$(id -g) \
        --user \$(id -u):\$(id -g) --cap-drop ALL --security-opt no-new-privileges \
        -v "\$WORKSPACE:/src" -w /src -e OPENCTEM_WORKSPACE=/src \
        -e OPENCTEM_ID_TOKEN -e OPENCTEM_API_URL -e OPENCTEM_TENANT_ID -e OPENCTEM_FAIL_ON=high \
        -e JENKINS_URL -e GIT_URL -e GIT_COMMIT -e GIT_BRANCH -e BRANCH_NAME \
        -e CHANGE_ID -e CHANGE_BRANCH -e CHANGE_TARGET -e CHANGE_FORK \
        ${image} ${args}
    """
}

pipeline {
    agent any
    options { timeout(time: 45, unit: 'MINUTES') }
    environment {
        OPENCTEM_API_URL = ''   // e.g. https://openctem.example.com
        OPENCTEM_TENANT_ID = '' // your OpenCTEM organization id; empty: scan only
    }
    stages {
        stage('OpenCTEM scans') {
            parallel {
                stage('sast')    { steps { script { openctem(ciImage, 'scan --capability sast    --aggregate --sarif /src/openctem-out/sast.sarif    --status /src/openctem-out/sast.status.json') } } }
                stage('sca')     { steps { script { openctem(ciImage, 'scan --capability sca     --aggregate --sarif /src/openctem-out/sca.sarif     --status /src/openctem-out/sca.status.json') } } }
                stage('secrets') { steps { script { openctem(ciImage, 'scan --capability secrets --aggregate --sarif /src/openctem-out/secrets.sarif --status /src/openctem-out/secrets.status.json') } } }
                stage('iac')     { steps { script { openctem(ciImage, 'scan --capability iac     --aggregate --sarif /src/openctem-out/iac.sarif     --status /src/openctem-out/iac.status.json') } } }
            }
        }
        stage('OpenCTEM gate') {
            steps { script { openctem(ciImage, 'gate --status-dir /src/openctem-out --expect sast,sca,secrets,iac') } }
        }
    }
    post {
        always { archiveArtifacts artifacts: 'openctem-out/**', allowEmptyArchive: true }
    }
}
